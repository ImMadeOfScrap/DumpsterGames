{
  "name": "dumpster-divers-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Dumpster Divers single-player Windows desktop game",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "com.dumpstergames.dumpsterdivers",
    "productName": "Dumpster Divers",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["main.cjs", "game/**/*", "package.json", "!game/data/**/*", "!**/*.tmp"],
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Dumpster-Divers-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": { "artifactName": "Dumpster-Divers-Portable-${version}-${arch}.${ext}" }
  }
}
